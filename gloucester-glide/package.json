{
  "name": "gloucester-glide",
  "private": true,
  "version": "0.1.0",
  "description": "Gloucester Glide – Käserollen den Hang hinunter (three.js + Rapier, Solo mit Ghosts und Bestenliste)",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "build": "vite build && node scripts/compress.mjs",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@dimforge/rapier3d-deterministic-compat": "^0.21.0",
    "@fastify/static": "^10.1.6",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "fastify": "^5.12.7",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "vite": "^8.3.4"
  }
}
